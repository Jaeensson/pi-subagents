{
  "name": "pi-subagent-extension",
  "version": "0.1.0",
  "description": "Subagent tool for pi: delegate tasks to isolated agent processes, synchronously (wait) or asynchronously (background + collect).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jaeensson/pi-subagents.git"
  },
  "type": "module",
  "keywords": ["pi-package"],
  "files": ["README.md", "LICENSE", "index.ts", "*.ts", "*.mjs", "*.d.mts", "tools/*.ts", "agents/*.md"],
  "pi": {
    "extensions": ["./index.ts"]
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@types/node": "22.19.19",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  }
}
